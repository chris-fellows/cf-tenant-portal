@model CFTenantPortal.Models.SendMessageVM

@{
    ViewData["Title"] = "Send Message";
}

@(await Component.InvokeAsync("PopupMessageComp"))

<h3>@Model.HeaderText</h3>

    <form asp-action="SendMessageForm">   
        @Html.LabelFor(m => m.MessageTypeId)
        @Html.DropDownListFor(m => m.MessageTypeId,
                 new SelectList(@Model.MessageTypeRefList, nameof(EntityReference.Id), nameof(EntityReference.Name)))
        <br />

        @Html.LabelFor(m => m.IssueId)
        @Html.DropDownListFor(m => m.IssueId,
                 new SelectList(@Model.IssueRefList, nameof(EntityReference.Id), nameof(EntityReference.Name)))
        <br />

        @Html.LabelFor(m => m.PropertyId)
        @Html.DropDownListFor(m => m.PropertyId,
                 new SelectList(@Model.PropertyRefList, nameof(EntityReference.Id), nameof(EntityReference.Name)))
        <br />

        @Html.LabelFor(m => m.PropertyOwnerId)
        @Html.DropDownListFor(m => m.PropertyOwnerId,
                 new SelectList(@Model.PropertyOwnerRefList, nameof(EntityReference.Id), nameof(EntityReference.Name)))
        <br />

        @Html.LabelFor(m => m.Text)
        <input class="form-control" type="text" asp-for="@Model.Text" />

        <button class="btn btn-primary" type="button" onclick="ConfirmAndSubmit();">Send</button>
</form>

@section Scripts
{
    <script>
        function ConfirmAndSubmit() {
            ShowPopupMessage("Do you want to send the message?",
                "Yes", function () {
                    HidePopupMessage();
                    $("#SendMessageForm").submit();
                },
                "No", function () {
                    HidePopupMessage();                    
                });              
        }
    </script>
}